{
  "title": "ZOA",
  "uid": "zoa",
  "description": "Unified ZOA service dashboard: SLIs, Trusted Action executions, HTTP API, worker pipeline, and underlying Lambda/DLQ/DynamoDB infrastructure. Single pane of glass for on-call.",
  "tags": [
    "zoa",
    "emf",
    "lambda",
    "dynamodb",
    "sqs",
    "sre"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "schemaVersion": 38,
  "graphTooltip": 1,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "tags": [],
      "title": "Lambda (infra)",
      "type": "link",
      "url": "/d/lambda-overview"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "label": "Datasource",
        "query": "prometheus",
        "current": {
          "text": "Thanos",
          "value": "Thanos"
        },
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "cluster",
        "type": "query",
        "label": "Cluster",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(aws_zoa_execution_count_sum, cluster)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "action",
        "type": "query",
        "label": "Action",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(aws_zoa_execution_count_sum{cluster=~\"$cluster\", dimension_Cluster=~\"$cluster\"}, dimension_Action)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "SLO Overview",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "TA Success Rate",
      "description": "Succeeded / all terminal executions in the current CloudWatch period. SLO target: 95%. Alert fires when <95% with >10 executions for 15m; this panel may show low percentages during quiet periods without triggering an alert.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(aws_zoa_execution_count_sum{dimension_Status=\"succeeded\", cluster=~\"$cluster\", dimension_Cluster=~\"$cluster\", dimension_Action=~\"$action\"}) / sum(aws_zoa_execution_count_sum{cluster=~\"$cluster\", dimension_Cluster=~\"$cluster\", dimension_Action=~\"$action\"})) and on() (sum(aws_zoa_execution_count_sum{cluster=~\"$cluster\", dimension_Cluster=~\"$cluster\", dimension_Action=~\"$action\"}) > 0)"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "No executions",
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 0.9,
                "color": "yellow"
              },
              {
                "value": 0.95,
                "color": "green"
              }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "API Availability",
      "description": "Non-5xx / total HTTP requests. SLO target: 99%. Excludes 4xx (client errors are expected: cooldown, validation). Alert fires when <99% with >10 requests for 15m; this panel may show low percentages during quiet periods without triggering an alert.",
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum(aws_zoa_http_request_count_sum{cluster=~\"$cluster\", dimension_Cluster=~\"$cluster\"}) - (sum(aws_zoa_http_request_count_sum{dimension_StatusClass=\"5xx\", cluster=~\"$cluster\", dimension_Cluster=~\"$cluster\"}) or vector(0))) / sum(aws_zoa_http_request_count_sum{cluster=~\"$cluster\", dimension_Cluster=~\"$cluster\"})) and on() (sum(aws_zoa_http_request_count_sum{cluster=~\"$cluster\", dimension_Cluster=~\"$cluster\"}) > 0)"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "No traffic",
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 0.95,
                "color": "yellow"
              },
              {
                "value": 0.99,
                "color": "green"
              }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Lambda Error Rate",
      "description": "Lambda-level error rate across ZOA functions. Complements API availability \u2014 a Lambda error means the entire request was lost.",
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(aws_lambda_errors_sum{dimension_FunctionName=~\".*-zoa-(api|worker)\", cluster=~\"$cluster\"}) / clamp_min(sum(aws_lambda_invocations_sum{dimension_FunctionName=~\".*-zoa-(api|worker)\", cluster=~\"$cluster\"}), 1) or vector(0)"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 0.01,
                "color": "red"
              }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Executions",
      "description": "Terminal TA execution count in the current YACE CloudWatch window (~120s).",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 3,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(aws_zoa_execution_count_sum{cluster=~\"$cluster\", dimension_Cluster=~\"$cluster\", dimension_Action=~\"$action\"}) or vector(0)"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "P99 Sync TA",
      "description": "P99 latency of sync Trusted Actions (in-Lambda execution). Async TAs run as K8s Jobs with longer deadlines \u2014 see P99 Async TA and Duration by Action.",
      "gridPos": {
        "x": 15,
        "y": 1,
        "w": 3,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(aws_zoa_execution_duration_p99{cluster=~\"$cluster\", dimension_Cluster=~\"$cluster\", dimension_Action=~\"$action\", dimension_Mode=\"sync\"}) or vector(0)"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "noValue": "No executions",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 30000,
                "color": "yellow"
              },
              {
                "value": 60000,
                "color": "red"
              }
            ]
          }
        }
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "P99 Async TA",
      "description": "P99 latency of async Trusted Actions (K8s Job-based). Minutes are normal \u2014 async TAs run outside Lambda with longer deadlines (must_gather: 30 min).",
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 3,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(aws_zoa_execution_duration_p99{cluster=~\"$cluster\", dimension_Cluster=~\"$cluster\", dimension_Action=~\"$action\", dimension_Mode=\"async\"}) or vector(0)"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "noValue": "No executions",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 600000,
                "color": "yellow"
              },
              {
                "value": 1200000,
                "color": "red"
              }
            ]
          }
        }
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "DLQ Depth",
      "description": "Visible messages on ZOA DLQ. Non-zero means worker/reconciler invocations failed and are not being retried.",
      "gridPos": {
        "x": 21,
        "y": 1,
        "w": 3,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(aws_sqs_approximate_number_of_messages_visible_maximum{dimension_QueueName=~\".*-zoa-dlq\", cluster=~\"$cluster\"}) or vector(0)"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1,
                "color": "red"
              }
            ]
          }
        }
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Activity Overview",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 41,
      "type": "barchart",
      "title": "Executions by Cluster",
      "description": "Total TA executions per cluster in the dashboard time range. Shows which RC/MC is busiest. Respects action filter.",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "stacking": "none",
        "barWidth": 0.7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (cluster) (sum_over_time(aws_zoa_execution_count_sum{cluster=~\"$cluster\", dimension_Cluster=~\"$cluster\", dimension_Action=~\"$action\"}[$__range]))",
          "legendFormat": "{{ cluster }}",
          "instant": true
        }
      ]
    },
    {
      "id": 37,
      "type": "barchart",
      "title": "Executions by Status",
      "description": "Total TA executions in the dashboard time range grouped by outcome. Respects cluster and action filters.",
      "gridPos": {
        "x": 5,
        "y": 7,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "stacking": "none",
        "barWidth": 0.7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (dimension_Status) (sum_over_time(aws_zoa_execution_count_sum{cluster=~\"$cluster\", dimension_Cluster=~\"$cluster\", dimension_Action=~\"$action\"}[$__range]))",
          "legendFormat": "{{ dimension_Status }}",
          "instant": true
        }
      ]
    },
    {
      "id": 38,
      "type": "barchart",
      "title": "Executions by Scope",
      "description": "kube-api (K8s operations) vs aws-api (AWS operations) in the dashboard time range. Respects cluster and action filters.",
      "gridPos": {
        "x": 10,
        "y": 7,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "stacking": "none",
        "barWidth": 0.7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (dimension_Scope) (sum_over_time(aws_zoa_execution_count_sum{cluster=~\"$cluster\", dimension_Cluster=~\"$cluster\", dimension_Action=~\"$action\"}[$__range]))",
          "legendFormat": "{{ dimension_Scope }}",
          "instant": true
        }
      ]
    },
    {
      "id": 39,
      "type": "barchart",
      "title": "Executions by Type",
      "description": "read (diagnostic) vs write (mutating) TAs in the dashboard time range. Respects cluster and action filters.",
      "gridPos": {
        "x": 15,
        "y": 7,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "stacking": "none",
        "barWidth": 0.7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (dimension_Type) (sum_over_time(aws_zoa_execution_count_sum{cluster=~\"$cluster\", dimension_Cluster=~\"$cluster\", dimension_Action=~\"$action\"}[$__range]))",
          "legendFormat": "{{ dimension_Type }}",
          "instant": true
        }
      ]
    },
    {
      "id": 40,
      "type": "barchart",
      "title": "Executions by Mode",
      "description": "sync (in-Lambda) vs async (K8s Job) TAs in the dashboard time range. Respects cluster and action filters.",
      "gridPos": {
        "x": 20,
        "y": 7,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "stacking": "none",
        "barWidth": 0.7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (dimension_Mode) (sum_over_time(aws_zoa_execution_count_sum{cluster=~\"$cluster\", dimension_Cluster=~\"$cluster\", dimension_Action=~\"$action\"}[$__range]))",
          "legendFormat": "{{ dimension_Mode }}",
          "instant": true
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Trusted Action Executions",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Executions by Action & Status",
      "description": "Breakdown of terminal TA executions by action name and outcome (succeeded/failed). Use to spot failing actions or unusual traffic patterns.",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (dimension_Action, dimension_Status) (aws_zoa_execution_count_sum{cluster=~\"$cluster\", dimension_Cluster=~\"$cluster\", dimension_Action=~\"$action\"})",
          "legendFormat": "{{ dimension_Action }} {{ dimension_Status }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "P99 Execution Duration by Action",
      "description": "Per-action P99 execution latency over time. Sync TAs should stay in seconds; async TAs (must_gather) in minutes. Spikes indicate degradation for that specific action.",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (dimension_Action) (aws_zoa_execution_duration_p99{cluster=~\"$cluster\", dimension_Cluster=~\"$cluster\", dimension_Action=~\"$action\"})",
          "legendFormat": "{{ dimension_Action }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Rejections by Reason",
      "description": "Cooldown, max concurrent, validation, action-not-found, circuit breaker. Expected traffic \u2014 do not page.",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (dimension_Reason) (aws_zoa_rejection_count_sum{cluster=~\"$cluster\", dimension_Cluster=~\"$cluster\"})",
          "legendFormat": "{{ dimension_Reason }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 20,
      "type": "row",
      "title": "HTTP API",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Request Count by Route & Status",
      "description": "Function URL has no API Gateway metrics. RouteTemplate is low-cardinality (no execution UUIDs).",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (dimension_RouteTemplate, dimension_StatusClass) (aws_zoa_http_request_count_sum{cluster=~\"$cluster\", dimension_Cluster=~\"$cluster\"})",
          "legendFormat": "{{ dimension_RouteTemplate }} {{ dimension_StatusClass }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "5xx vs 4xx by Cluster",
      "description": "4xx includes cooldown and validation rejections (expected). 5xx means API unavailability.",
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cluster) (aws_zoa_http_request_count_sum{dimension_StatusClass=\"5xx\", cluster=~\"$cluster\", dimension_Cluster=~\"$cluster\"})",
          "legendFormat": "{{ cluster }} 5xx"
        },
        {
          "refId": "B",
          "expr": "sum by (cluster) (aws_zoa_http_request_count_sum{dimension_StatusClass=\"4xx\", cluster=~\"$cluster\", dimension_Cluster=~\"$cluster\"})",
          "legendFormat": "{{ cluster }} 4xx"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/5xx/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
